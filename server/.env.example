PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iap_liaison
JWT_SECRET=You-can-get-it
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123
# Optional: lets RTB systems read school totals at GET /api/integration/summary (header x-api-key). Leave empty to disable.
RTB_API_KEY=
# Set to true when running behind nginx/Caddy so rate limits see the real client IP
TRUST_PROXY=
