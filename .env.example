# Used by docker compose. Copy to .env and change every value.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
# 64+ random characters, e.g. run: openssl rand -hex 48
JWT_SECRET=You-can-get-it
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123
# The public address of the site (for CORS), e.g. https://iap.example.rw
CLIENT_ORIGIN=http://localhost
# Optional: lets RTB systems read school totals (GET /api/integration/summary, header x-api-key)
RTB_API_KEY=
WEB_PORT=80
